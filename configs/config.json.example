{
  "dataRoot": "data",
  "repositoryRoot": "repository",
  "repositoryIndex": "repositories.json",
  "syncInterval": "6h",
  "gitCommandTimeout": "20m",
  "maxParallelSyncs": 2,
  "httpAddress": "127.0.0.1:9997",
  "apiKeys": [
    "replace-with-a-random-key-at-least-16-chars"
  ],
  "defaultHistory": "shallow",
  "gcThresholdMB": 2048,
  "gcGrowthMB": 300,
  "sizeLimitMB": 5120
}
