# 复制为 deploy.env 后按本机情况修改；deploy.env 不参与版本管理。
# 与 Docker 用的 .env 分开：那份给 compose，这份给 Windows 启动脚本。

# 部署目录（二进制与数据所在处）
EUCLI_DEPLOY_DIR=E:\TOOOOOLSbox\eucli-deep-wiki-deploy

# 二进制文件名，用于进程判重，只填文件名
EUCLI_EXE=reference-sync.exe

# 配置文件，可写相对部署目录的路径，也可写绝对路径
EUCLI_CONFIG=config\config.json

# 日志位置，日志文件名固定为 EUCLI_LOG_FILE
EUCLI_LOG_DIR=logs
EUCLI_LOG_FILE=sync.log

# 注册成任务或服务时使用的名字
EUCLI_SERVICE_NAME=eucli-deep-wiki

# 走 nssm 路线时才需要：nssm.exe 的绝对路径，留空则从 PATH 查找
# EUCLI_NSSM=C:\tools\nssm\nssm.exe
